# Text chat / story / doctor AI
XUANJI_API_KEY=your_text_chat_api_key_here
XUANJI_API_URL=https://hub.chx1008.com/v1/chat/completions
DEFAULT_MODEL=Doubao-Seed-2.0-pro

# Generate a long random value for production. Changing it logs everyone out.
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=10485760

# Speech Recognition Provider (mock, tencent, alibaba)
SPEECH_PROVIDER=mock

# Tencent Cloud Speech Configuration
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=

# Alibaba Cloud Speech Configuration
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_APP_KEY=
